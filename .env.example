# ---------------------------------------------------------------------------
# Facultatif : InfosHebdo fonctionne sans fichier .env.
# Copier ce fichier en ".env" pour ajuster ces valeurs. Le .env n'est jamais
# commite.
# ---------------------------------------------------------------------------

# Emplacement de la base (par defaut : data/infoshebdo.sqlite3)
# INFOSHEBDO_DB=D:/Recherches/Vendors/Programs/InfosHebdo/data/infoshebdo.sqlite3

# Delai de politesse entre deux requetes HTTP, en secondes (defaut : 1.0)
# INFOSHEBDO_HTTP_DELAY=1.0

# Garde en cache disque les pages telechargees : utile pour mettre au point un
# parser sans marteler les sites (data/cache/).
# INFOSHEBDO_HTTP_CACHE=1
