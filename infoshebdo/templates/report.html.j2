{#
  Gabarit du rapport hebdomadaire, ouvert tel quel dans le navigateur.

  Les styles restent poses en attribut `style` sur chaque element et la mise
  en page en <table> : le fichier est autonome (ni feuille externe, ni script)
  et se deplace ou s'archive sans rien perdre.
#}
{%- set FONT = "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif" -%}
{%- set INK = "#1c1c1e" -%}
{%- set MUTED = "#6b7280" -%}
{%- set LINE = "#e5e7eb" -%}
{%- set UP = "#0b8457" -%}
{%- set DOWN = "#c0392b" -%}
{%- macro delta_color(css) -%}
{%- if css == 'up' -%}{{ UP }}{%- elif css == 'down' -%}{{ DOWN }}{%- else -%}{{ MUTED }}{%- endif -%}
{%- endmacro -%}
{%- macro badge(text) -%}
{%- set colors = {'officiel': '#0b8457', 'estime': '#b45309', 'partiel': '#0369a1', 'extrapole': '#7c3aed', 'tiers': '#6b7280', 'manuel': '#374151'} -%}
<span style="display:inline-block;padding:1px 7px;border-radius:9px;font-size:11px;font-weight:600;color:#ffffff;background:{{ colors.get(text, '#6b7280') }};">{{ text }}</span>
{%- endmacro -%}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ report.title }} - {{ report.week_label }}</title>
</head>
<body style="margin:0;background:#f4f4f5;">
<div style="{{ FONT }};background:#f4f4f5;padding:24px 12px;color:{{ INK }};">
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="width:100%;max-width:760px;margin:0 auto;background:#ffffff;border-radius:10px;border:1px solid {{ LINE }};">

  {# ---------------------------------------------------------------- en-tete #}
  <tr><td style="padding:26px 28px 18px 28px;border-bottom:2px solid {{ INK }};">
    <div style="font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:{{ MUTED }};font-weight:600;">
      {{ report.week_label }} &nbsp;&middot;&nbsp; {{ report.period_start.strftime('%d/%m/%Y') }} au {{ report.period_end.strftime('%d/%m/%Y') }}
    </div>
    <h1 style="margin:6px 0 0 0;font-size:24px;line-height:1.25;font-weight:700;">{{ report.title }}</h1>
    <p style="margin:10px 0 0 0;font-size:15px;line-height:1.5;color:{{ INK }};">{{ report.headline }}</p>
  </td></tr>

  {# ----------------------------------------------------------- avertissements #}
  {% for notice in report.notices %}
  <tr><td style="padding:16px 28px 0 28px;">
    <div style="padding:10px 12px;background:#fef3c7;border-left:4px solid #d97706;font-size:13px;line-height:1.5;color:#78350f;"><strong>Attention :</strong> {{ notice }}</div>
  </td></tr>
  {% endfor %}

  {# ------------------------------------------------------------------ corps #}
  {% for section in report.sections %}
  <tr><td style="padding:26px 28px 4px 28px;">
    <h2 style="margin:0;font-size:18px;font-weight:700;border-left:4px solid {{ INK }};padding-left:10px;">{{ section.title }}</h2>
    {% if section.intro %}
    <p style="margin:10px 0 0 0;font-size:13px;line-height:1.55;color:{{ MUTED }};">{{ section.intro }}</p>
    {% endif %}
  </td></tr>

  {% for table in section.tables %}
  {% if table.rows or show_empty %}
  <tr><td style="padding:18px 28px 0 28px;">

    <div style="font-size:15px;font-weight:600;margin-bottom:2px;">{{ table.title }}</div>
    <div style="font-size:12px;color:{{ MUTED }};margin-bottom:8px;">
      {% if table.period_label %}{{ table.period_label }} &nbsp;&middot;&nbsp; {% endif %}{{ table.source_label }}
      {% if table.reliability and table.reliability != '-' %} &nbsp;{{ badge(table.reliability) }}{% endif %}
    </div>

    {% if table.warning %}
    <div style="margin:0 0 10px 0;padding:9px 11px;background:#fef3c7;border-left:3px solid #d97706;font-size:12px;line-height:1.5;color:#78350f;">
      <strong>Attention :</strong> {{ table.warning }}
    </div>
    {% endif %}

    {% if table.rows %}
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;font-size:13px;">
      <tr>
        {% for column in table.columns %}
        <th style="text-align:{{ 'left' if loop.index0 == 1 else ('center' if loop.index0 == 0 else 'right') }};padding:6px 8px;border-bottom:1px solid {{ INK }};font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:{{ MUTED }};font-weight:600;">{{ column }}</th>
        {% endfor %}
      </tr>
      {% for row in table.rows %}
      <tr style="background:{{ '#fafafa' if loop.index0 % 2 else '#ffffff' }};">
        <td style="padding:7px 8px;text-align:center;border-bottom:1px solid {{ LINE }};color:{{ MUTED }};font-variant-numeric:tabular-nums;">{{ row.rank if row.rank else '-' }}</td>
        <td style="padding:7px 8px;border-bottom:1px solid {{ LINE }};">
          {% if row.url %}<a href="{{ row.url }}" style="color:{{ INK }};text-decoration:none;font-weight:600;">{{ row.title }}</a>
          {% else %}<span style="font-weight:600;">{{ row.title }}</span>{% endif %}
          {% if row.is_new %} <span style="font-size:10px;color:{{ UP }};font-weight:700;">NOUVEAU</span>{% endif %}
          {% if row.detail %}<div style="font-size:11px;color:{{ MUTED }};margin-top:1px;">{{ row.detail }}</div>{% endif %}
        </td>
        <td style="padding:7px 8px;text-align:right;border-bottom:1px solid {{ LINE }};font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;">{{ row.value_fmt }}</td>
        <td style="padding:7px 8px;text-align:right;border-bottom:1px solid {{ LINE }};white-space:nowrap;font-variant-numeric:tabular-nums;">
          {% if row.delta_pct %}<span style="color:{{ delta_color(row.delta_class) }};font-weight:600;">{{ row.delta_pct }}</span>
          {% elif row.move %}<span style="color:{{ delta_color(row.move_class) }};font-weight:600;">{{ row.move }}</span>
          {% else %}<span style="color:{{ MUTED }};">-</span>{% endif %}
        </td>
        {% if table.columns|length > 4 %}
        <td style="padding:7px 8px;text-align:right;border-bottom:1px solid {{ LINE }};color:{{ MUTED }};font-variant-numeric:tabular-nums;white-space:nowrap;">{{ row.secondary or '-' }}</td>
        {% endif %}
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <div style="padding:12px;background:#f9fafb;border:1px dashed {{ LINE }};font-size:12px;color:{{ MUTED }};">
      Pas de donnee. {{ table.note }}
    </div>
    {% endif %}

    {% if table.note and table.rows %}
    <p style="margin:7px 0 0 0;font-size:11px;line-height:1.5;color:{{ MUTED }};">{{ table.note }}</p>
    {% endif %}
  </td></tr>
  {% endif %}
  {% endfor %}

  {# ------------------------------------------- veille presse de la section #}
  {% if section.news %}
  <tr><td style="padding:18px 28px 0 28px;">
    <div style="font-size:15px;font-weight:600;margin-bottom:8px;">Publications de classements reperees</div>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;font-size:13px;">
      {% for item in section.news %}
      <tr>
        <td style="padding:7px 8px 7px 0;border-bottom:1px solid {{ LINE }};">
          <a href="{{ item.url }}" style="color:{{ INK }};font-weight:600;text-decoration:none;">{{ item.title }}</a>
          <div style="font-size:11px;color:{{ MUTED }};margin-top:2px;">
            {{ item.source }}{% if item.published_at %} &middot; {{ item.published_at }}{% endif %}{% if item.markets %} &middot; {{ item.markets|join(', ') }}{% endif %}
          </div>
        </td>
      </tr>
      {% endfor %}
    </table>
    <p style="margin:7px 0 0 0;font-size:11px;color:{{ MUTED }};">
      Liens vers des articles de presse : les chiffres qu'ils citent ne sont pas
      verifies a la source et ne sont pas stockes.
    </p>
  </td></tr>
  {% endif %}
  {% endfor %}

  {# --------------------------------------------------------------- legende #}
  {% if report.legend %}
  <tr><td style="padding:26px 28px 0 28px;">
    <h2 style="margin:0 0 10px 0;font-size:14px;font-weight:700;">Fiabilite des chiffres</h2>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;font-size:12px;">
      {% for key, help in report.legend.items() %}
      <tr>
        <td style="padding:4px 10px 4px 0;white-space:nowrap;vertical-align:top;">{{ badge(key) }}</td>
        <td style="padding:4px 0;color:{{ MUTED }};line-height:1.5;">{{ help }}</td>
      </tr>
      {% endfor %}
    </table>
  </td></tr>
  {% endif %}

  {# --------------------------------------------------- journal de collecte #}
  {% if report.run_log %}
  <tr><td style="padding:22px 28px 0 28px;">
    <h2 style="margin:0 0 8px 0;font-size:14px;font-weight:700;">Derniere collecte</h2>
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;font-size:12px;">
      {% for entry in report.run_log %}
      {%- set color = {'ok': UP, 'erreur': DOWN, 'vide': MUTED, 'desactive': MUTED}.get(entry.status, MUTED) -%}
      <tr>
        <td style="padding:4px 8px 4px 0;color:{{ color }};font-weight:600;white-space:nowrap;vertical-align:top;">{{ entry.status }}</td>
        <td style="padding:4px 8px 4px 0;vertical-align:top;">{{ entry.label or entry.collector }}</td>
        <td style="padding:4px 0;text-align:right;color:{{ MUTED }};white-space:nowrap;vertical-align:top;">{{ entry.rows }} lignes</td>
      </tr>
      {% if entry.status == 'erreur' and entry.message %}
      <tr><td colspan="3" style="padding:0 0 6px 0;font-size:11px;color:{{ DOWN }};">{{ entry.message }}</td></tr>
      {% endif %}
      {% endfor %}
    </table>
  </td></tr>
  {% endif %}

  {# ----------------------------------------------------------------- pied #}
  <tr><td style="padding:20px 28px 26px 28px;border-top:1px solid {{ LINE }};margin-top:20px;">
    <p style="margin:0;font-size:11px;line-height:1.6;color:{{ MUTED }};">
      Genere le {{ report.generated_at }} par InfosHebdo &middot;
      {{ report.stats.observations }} observations en base
      {%- if report.stats.first_period %} (du {{ report.stats.first_period }} au {{ report.stats.last_period }}){% endif %}.<br>
      Les donnees de box-office France et Japon sont publiees avec plusieurs
      semaines de retard : une semaine incomplete aujourd'hui se remplira aux
      collectes suivantes.
    </p>
  </td></tr>

</table>
</div>
</body>
</html>
